# COMPAT_VDSO needs a 32-bit cross compiler, which the Android 17 tree does not provide.
# CONFIG_COMPAT_VDSO is not set
# sign-file is built against BoringSSL, which cannot sign modules.
# CONFIG_MODULE_SIG is not set
# CONFIG_MODULE_SIG_ALL is not set
# The GMS system APEX (com.google.android.gmssystem) is an EROFS image.
CONFIG_EROFS_FS=y
CONFIG_EROFS_FS_XATTR=y
CONFIG_EROFS_FS_POSIX_ACL=y
CONFIG_EROFS_FS_SECURITY=y
CONFIG_EROFS_FS_ZIP=y
# Required by kernel/configs/t/android-4.14/android-base.config and missing from the
# Sony defconfig (all of them exist in this 4.14 tree, none need code changes).
CONFIG_MEMBARRIER=y
CONFIG_UTS_NS=y
CONFIG_VETH=y
CONFIG_XFRM_MIGRATE=y
CONFIG_NET_ACT_POLICE=y
CONFIG_NET_ACT_BPF=y
CONFIG_NET_CLS_MATCHALL=y
CONFIG_NET_SCH_TBF=y
CONFIG_CRYPTO_CHACHA20POLY1305=y
CONFIG_DEBUG_LIST=y
CONFIG_DM_SNAPSHOT=y
CONFIG_RD_LZ4=y
CONFIG_HID_SONY=y
CONFIG_SONY_FF=y
CONFIG_USERFAULTFD=y
# vendor is installed as squashfs (400MiB oem partition).
CONFIG_SQUASHFS=y
# CONFIG_SQUASHFS_FILE_CACHE is not set
CONFIG_SQUASHFS_FILE_DIRECT=y
# CONFIG_SQUASHFS_DECOMP_SINGLE is not set
# CONFIG_SQUASHFS_DECOMP_MULTI is not set
CONFIG_SQUASHFS_DECOMP_MULTI_PERCPU=y
CONFIG_SQUASHFS_XATTR=y
CONFIG_SQUASHFS_ZLIB=y
CONFIG_SQUASHFS_LZ4=y
# CONFIG_SQUASHFS_LZO is not set
# CONFIG_SQUASHFS_XZ is not set
# File-based encryption: fs/crypto and fs/ext4 come from android-4.14-stable (fscrypt v2 and
# FS_IOC_ADD_ENCRYPTION_KEY, which Android 14+ vold requires). Qualcomm's ICE/PFK path only
# worked with the old fscrypt, so contents are encrypted in software (ARMv8 CE).
CONFIG_FS_ENCRYPTION=y
# CONFIG_PFK is not set
# CONFIG_EXT4_FS_ICE_ENCRYPTION is not set
# CONFIG_FS_VERITY is not set
# CONFIG_UNICODE is not set
# f2fs is not used on maple and still has the old fscrypt API
# CONFIG_F2FS_FS is not set

# KernelSU-Next (manual hooks)
CONFIG_KSU=y
CONFIG_KSU_MANUAL_HOOK=y
